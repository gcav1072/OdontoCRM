#!/usr/bin/env bash
# =============================================================================
# OdontoCRM · comandos del servidor (una sola puerta)
#
#   sudo odontocrm                 # ayuda
#   sudo odontocrm estado          # tablero completo (con el entorno de producción)
#   sudo odontocrm alertas         # solo los problemas; código 1 si hay alguno
#   sudo odontocrm respaldar       # respaldo ahora (bases + configuración)
#   sudo odontocrm verificar       # los 9 servicios: unidad, puerto y /health
#   sudo odontocrm servicios       # estado de las 10 unidades
#   sudo odontocrm logs clinical   # últimos registros de un servicio
#   sudo odontocrm actualizar      # traer el código nuevo y reiniciar (RUNBOOK §8)
#
# Existe para que en la clínica no haya que recordar rutas, `sudo`, variables de
# entorno ni en qué orden se carga todo. Cada orden delega en el script que ya está
# probado: aquí solo se pone el entorno correcto y se dice qué se está haciendo.
# =============================================================================
set -uo pipefail

# ── Aviso de dónde se corta ──────────────────────────────────────────────────
# Un guion que se corta EN SILENCIO es el peor fallo posible: pasó en el ensayo de la
# Fase 10, que moría (por una variable sin definir, con `set -u`) justo antes de imprimir
# el «Resumen» y de reiniciar, y parecía que el reinicio «no funcionaba».
#
# Este aviso NO cambia el comportamiento (los guiones siguen adelante donde ya lo hacían):
# solo dice por stderr en qué línea se detuvo y con qué código. Cuando bash aborta por
# `set -u`, esto imprime la línea exacta; cuando un comando falla y el guion continúa,
# queda anotado para que nadie se quede sin saberlo.
trap 'codigo=$?; printf "\n✖ %s: un comando devolvió error en la línea %s (código %s):\n    %s\n" "${0##*/}" "$LINENO" "$codigo" "$(sed -n "${LINENO}p" "$0" | sed "s/^ *//")" >&2' ERR

# Y un aviso de SALIDA: se ejecuta siempre, incluso cuando bash aborta por `set -u` (ese
# caso **no** pasa por el trap de ERR). Es el que habría dicho «el ensayo terminó con
# error en la línea X» en vez de dejar una salida truncada que parecía un reinicio roto.
trap 'codigo=$?; if (( codigo != 0 )) && [[ "$BASH_COMMAND" != exit* ]]; then printf "\n✖ %s terminó con error (código %s). Última orden:\n    %s\n" "${0##*/}" "$codigo" "$BASH_COMMAND" >&2; fi' EXIT


CODE_DIR="${CODE_DIR:-/opt/odontocrm}"
ETC_DIR="${ODONTOCRM_ENV_DIR:-/etc/odontocrm}"
SERVICIOS=(identity patients scheduling notifications clinical odontogram screens reporting billing)

C_OK=$'\e[32m'; C_AV=$'\e[33m'; C_ER=$'\e[31m'; C_TI=$'\e[1m'; C_RE=$'\e[0m'
ok()   { printf '  %s✔%s %s\n' "$C_OK" "$C_RE" "$1"; }
av()   { printf '  %s!%s %s\n' "$C_AV" "$C_RE" "$1"; }
err()  { printf '  %s✖%s %s\n' "$C_ER" "$C_RE" "$1"; }
morir(){ err "$1"; exit 1; }

necesita_root() {
  [[ $EUID -eq 0 ]] && return 0
  err "esta orden necesita sudo: sudo odontocrm $ORDEN"
  exit 1
}

ayuda() {
  cat <<EOF
${C_TI}OdontoCRM · comandos del servidor${C_RE}

  sudo odontocrm estado            Tablero completo: servicios, unidades, bases, cola,
                                   outbox, envíos, reportes y alertas.
  sudo odontocrm alertas           Solo los problemas. Sale con 1 si hay alguno
                                   (es lo que ejecuta el temporizador cada 5 minutos).
  sudo odontocrm respaldar         Respaldo ahora mismo de las 8 bases y de la
                                   configuración (/etc/odontocrm, CONTIENE SECRETOS).
  sudo odontocrm restaurar ...     Restaurar desde un respaldo (pasa las opciones tal
                                   cual: --from /var/backups/odontocrm/<fecha> --all --yes).
  sudo odontocrm verificar         Los 9 servicios: unidad activa, puerto servido por
                                   ELLA y /health + /ready en 200. Espera (hasta 45 s,
                                   ODONTOCRM_ESPERA) a que todos escuchen: tras un
                                   reinicio no tardan todos lo mismo.
  sudo odontocrm servicios         Estado de las 10 unidades de systemd.
  sudo odontocrm logs <servicio|gateway|nginx|postgres> [líneas]
                                   Últimos registros.
  sudo odontocrm actualizar [--rama=<nombre>]
                                   Actualización de rutina: trae el código, pone al día
                                   unidades y plantillas, compila, migra, reinicia y
                                   verifica. Sigue la rama del despliegue (con
                                   `--rama=main` cambia a esa y se queda en ella).
                                   Para el despliegue COMPLETO con evidencia (TLS,
                                   firewall, SELinux, respaldo y restauración probada)
                                   está `infra/fedora/ensayo-despliegue.sh`.
  sudo odontocrm parar             Detener los 9 servicios (el gateway primero: es la
                                   puerta). nginx y PostgreSQL se quedan; con `--todo`
                                   se paran también ellos (sistema completamente parado).
  sudo odontocrm arrancar          Arrancarlos en orden y comprobar que los 9 responden.
                                   Sirve igual si el sistema estaba parado del todo.
  sudo odontocrm reiniciar         Reiniciar los 9 (aplicar configuración). Funciona
                                   también con el sistema parado: arranca lo que falte.
  sudo odontocrm compilar          Solo compilar (TypeScript → dist/), sin tocar servicios.
                                   El ciclo completo es: parar → compilar → arrancar.
  sudo odontocrm recompilar        Compilar y reiniciar de una vez, sin tocar el repositorio
                                   ni la base (atajo de lo anterior).
  sudo odontocrm certificado       Muestra el certificado y el estado de la CA interna, y
                                   exporta los archivos para instalar en tablets, móviles
                                   y TVs (--exportar /ruta). Es lo que quita el aviso de
                                   «conexión no privada» en los demás equipos.
  sudo odontocrm credenciales      Comprueba que las 9 credenciales de /etc/odontocrm
                                   CONECTAN de verdad, una por una (no imprime secretos).
                                   Ya no copia nada: hay una sola copia de cada secreto.
                                   Si alguna falla, se arregla aprovisionando otra vez:
                                   sudo bash infra/fedora/instalar/20-aprovisionar.sh
  sudo odontocrm red               En qué IP se está sirviendo y con qué dirección entrar
                                   desde otro equipo. Comprueba lo que se queda apuntando
                                   a la red anterior al cambiar de wifi/router (firewall,
                                   certificado, CORS y el nombre mDNS).
  sudo odontocrm red --arreglar    Lo adapta solo: firewall por zona (sigue a la interfaz,
                                   no a un rango fijo), certificado reemitido con la IP
                                   de ahora (misma CA: los equipos no tocan nada) y
                                   WEB_ORIGIN actualizado.
  sudo odontocrm selinux           Denegaciones de SELinux de hoy, con la causa más
                                   probable y el comando que lo arregla. «Sin
                                   denegaciones» es lo que quieres ver.
  sudo odontocrm con-entorno <servicio> -- <comando>
                                   Ejecuta cualquier herramienta con el entorno de
                                   producción ya cargado (común + del servicio). Los
                                   secretos no se escriben en la línea de comandos.
                                   Ej.: sudo odontocrm con-entorno identity -- \
                                        node services/identity/dist/seed.js --reset
  sudo odontocrm modo-test <on|off|estado>
                                   Leer o escribir el modo test (nunca en producción
                                   con datos reales: ver el ADR 0020).

Directorio del código: $CODE_DIR
Configuración:         $ETC_DIR
EOF
}

ORDEN="${1:-ayuda}"
shift || true

case "$ORDEN" in
  ayuda|-h|--help|help) ayuda ;;

  estado)
    necesita_root
    cd "$CODE_DIR" || morir "no existe $CODE_DIR"
    ODONTOCRM_ENV_DIR="$ETC_DIR" exec node tools/estado.mjs "$@"
    ;;

  alertas)
    necesita_root
    cd "$CODE_DIR" || morir "no existe $CODE_DIR"
    ODONTOCRM_ENV_DIR="$ETC_DIR" exec node tools/estado.mjs --alertas "$@"
    ;;

  respaldar|respaldo)
    necesita_root
    exec bash "$CODE_DIR/infra/fedora/backup/odontocrm-backup.sh" --include-config "$@"
    ;;

  restaurar)
    necesita_root
    exec bash "$CODE_DIR/infra/fedora/backup/odontocrm-restore.sh" "$@"
    ;;

  verificar)
    necesita_root
    command -v curl >/dev/null || morir 'falta curl'
    declare -A PUERTOS=([identity]=4001 [patients]=4002 [scheduling]=4003 [notifications]=4004
                        [clinical]=4005 [odontogram]=4006 [screens]=4007 [reporting]=4008 [billing]=4009 [gateway]=8090)

    # Tras un reinicio (o un `actualizar`) los servicios no tardan todos lo mismo en
    # escuchar: notifications y clinical levantan plantillas y el navegador antes de
    # abrir el puerto. Comprobar de inmediato daba falsos negativos —«el puerto lo sirve
    # el PID nadie» y el /ready del gateway en 503— que parecían averías. Se espera, con
    # tope, a que cada unidad activa esté sirviendo SU puerto.
    limite=$(( $(date +%s) + ${ODONTOCRM_ESPERA:-45} ))
    esperados=( "${SERVICIOS[@]}" gateway )
    while :; do
      pendientes=0
      for svc in "${esperados[@]}"; do
        puerto="${PUERTOS[$svc]}"
        unidad="odontocrm@$svc"; [[ "$svc" == "gateway" ]] && unidad="odontocrm-gateway"
        # Solo se espera a las unidades ACTIVAS: si una está apagada, no es cuestión de
        # darle tiempo, es que nadie la arrancó (y eso se informa abajo, como inactiva).
        systemctl is-active --quiet "$unidad.service" || continue
        pid_unidad="$(systemctl show -p MainPID --value "$unidad.service" 2>/dev/null || echo 0)"
        pid_puerto="$(ss -lntpH "sport = :$puerto" 2>/dev/null | grep -oP 'pid=\K[0-9]+' | head -1 || true)"
        [[ -n "$pid_puerto" && "$pid_puerto" == "$pid_unidad" ]] || pendientes=$((pendientes + 1))
      done
      (( pendientes == 0 )) && break
      if (( $(date +%s) >= limite )); then
        av "$pendientes servicio(s) seguían sin escuchar tras ${ODONTOCRM_ESPERA:-45} s"
        break
      fi
      sleep 2
    done

    # Marcadores de plantilla sin sustituir. Es el fallo más silencioso de todos: el
    # servicio ARRANCA (el marcador cumple la longitud mínima del esquema) y luego usa un
    # valor del repositorio — el secreto compartido de las rutas internas, la dirección del
    # QR del récipe o el usuario del bot — como si fuera real.
    marcadores=0
    while IFS= read -r linea; do
      [[ -n "$linea" ]] || continue
      marcadores=$((marcadores + 1))
    done < <(grep -rEl '=(CAMBIAR|CAMBIAR_)[A-Z_0-9]*' "$ETC_DIR"/*.env 2>/dev/null || true)
    if (( marcadores > 0 )); then
      av "$marcadores archivo(s) de /etc/odontocrm con marcadores CAMBIAR_* sin sustituir:"
      grep -rEo '^[A-Z_0-9]+=CAMBIAR[A-Z_0-9]*' "$ETC_DIR"/*.env 2>/dev/null |
        sed "s|$ETC_DIR/||" | sed 's/^/      /' | head -8
      av '  se arreglan rellenando esos valores en /etc/odontocrm y reiniciando el servicio'
    else
      ok 'ningún marcador CAMBIAR_* sin sustituir en /etc/odontocrm'
    fi

    fallos=0
    for svc in "${SERVICIOS[@]}" gateway; do
      puerto="${PUERTOS[$svc]}"
      unidad="odontocrm@$svc"; [[ "$svc" == "gateway" ]] && unidad="odontocrm-gateway"
      activa="$(systemctl is-active "$unidad.service" 2>/dev/null || true)"
      pid_unidad="$(systemctl show -p MainPID --value "$unidad.service" 2>/dev/null || echo 0)"
      pid_puerto="$(ss -lntpH "sport = :$puerto" 2>/dev/null | grep -oP 'pid=\K[0-9]+' | head -1 || true)"
      if [[ "$activa" != "active" ]]; then
        err "$unidad: $activa"; fallos=$((fallos + 1)); continue
      fi
      if [[ "$pid_puerto" != "$pid_unidad" ]]; then
        err "el puerto $puerto lo sirve el PID ${pid_puerto:-nadie}, no $unidad (PID $pid_unidad)"
        fallos=$((fallos + 1)); continue
      fi
      for ruta in health ready; do
        codigo="$(curl -s -o /dev/null -m 5 -w '%{http_code}' "http://127.0.0.1:$puerto/$ruta" || echo 000)"
        if [[ "$codigo" == "200" ]]; then ok "$svc :$puerto /$ruta 200"
        else err "$svc :$puerto /$ruta → $codigo"; fallos=$((fallos + 1)); fi
      done
    done
    echo
    if (( fallos == 0 )); then ok 'los 9 servicios están bien'; else err "$fallos comprobación(es) con problemas"; fi
    exit $(( fallos > 0 ))
    ;;

  servicios)
    necesita_root
    systemctl --no-pager --type=service --all 'odontocrm*' | cat
    echo
    systemctl --no-pager --type=service --all 'nginx*' 'postgresql*' | cat
    ;;

  logs)
    necesita_root
    que="${1:-clinical}"; shift || true
    lineas="${1:-50}"
    case "$que" in
      gateway) exec journalctl -u odontocrm-gateway -n "$lineas" --no-pager ;;
      nginx)   exec journalctl -u nginx -n "$lineas" --no-pager ;;
      postgres|postgresql) exec journalctl -u postgresql -n "$lineas" --no-pager ;;
      *)       exec journalctl -u "odontocrm@$que" -n "$lineas" --no-pager ;;
    esac
    ;;

  actualizar)
    necesita_root
    cd "$CODE_DIR" || morir "no existe $CODE_DIR"
    git config --global --add safe.directory "$CODE_DIR" 2>/dev/null || true
    printf '%sActualizando %s%s\n' "$C_TI" "$CODE_DIR" "$C_RE"
    # Qué rama se despliega: por defecto, la que ya tiene el despliegue (así
    # `actualizar` es predecible: nunca salta de rama solo). Con `--rama=<nombre>` se
    # cambia a propósito —por ejemplo, al pasar de una rama de fase a `main`—.
    rama_objetivo=""
    for arg in "$@"; do
      case "$arg" in --rama=*) rama_objetivo="${arg#*=}" ;; esac
    done
    git fetch --prune origin || morir 'no pude traer el código nuevo'
    rama_actual="$(git rev-parse --abbrev-ref HEAD || true)"
    rama="${rama_objetivo:-$rama_actual}"
    if [[ -n "$rama_objetivo" && "$rama_objetivo" != "$rama_actual" ]]; then
      av "cambio de rama: $rama_actual → $rama_objetivo"
    fi
    git checkout -B "$rama" "origin/$rama" ||
      morir "no pude cambiar a la rama '$rama' (¿existe en el origen? ¿la escribiste bien?)"
    ok "rama $rama · código en $(git rev-parse --short HEAD)"

    # Código compilado, unidades, temporizadores, certificado, proxy, SELinux y
    # firewall: lo pone al día la MISMA pieza del instalador, que es idempotente.
    #
    # Antes esto llamaba a `install.sh`, que además generaba plantillas de
    # /etc/odontocrm. Eso era un SEGUNDO escritor de la configuración y la puerta
    # por la que volvían los secretos desfasados (ADR 0043). Ahora la única pieza
    # que escribe /etc/odontocrm es 20-aprovisionar.sh, y las actualizaciones NO la
    # tocan: las credenciales no se rotan porque llegue una versión nueva.
    # El registro se pre-crea 0600: la salida del despliegue puede traer datos que no
    # deben quedar legibles para cualquiera en /tmp (contraseñas temporales, rutas).
    install -m 0600 -o root -g root /dev/null /tmp/odontocrm-actualizar.log 2>/dev/null || true
    if bash "$CODE_DIR/infra/fedora/instalar/30-desplegar.sh" \
         >/tmp/odontocrm-actualizar.log 2>&1; then
      ok 'código compilado, unidades, migraciones, TLS y proxy al día'
    else
      tail -20 /tmp/odontocrm-actualizar.log
      av 'el despliegue falló: el código se actualizó, pero revisa /tmp/odontocrm-actualizar.log'
    fi

    # ── Cambiar de versión a mitad de camino, sin romperse ────────────────────
    #
    # Este proceso empezó con la versión ANTIGUA del comando. ¿Qué pasa si el commit
    # que acaba de llegar trae una versión nueva de este mismo guion (por ejemplo, un
    # arreglo en las migraciones o en `verificar`)? Si siguiéramos aquí, los pasos que
    # quedan correrían con la lógica vieja —el arreglo no se aplicaría hasta la próxima
    # vez— y, peor, el guion seguiría leyéndose del archivo mientras otro lo reemplaza.
    #
    # Bash **no** carga el archivo entero en memoria: lo va leyendo por bloques desde el
    # descriptor abierto. Como `install.sh` instala el comando con `install` (crea un
    # archivo NUEVO y renombra), el proceso que corre conserva el descriptor del archivo
    # original y termina sano —por eso no se corrompe nada—, pero seguiría ejecutando la
    # versión vieja. La forma limpia de cambiar es **re-ejecutarse**: `exec "$0" …`
    # reemplaza el proceso y vuelve a leer el archivo, ya nuevo. Una sola vez, con una
    # variable de guarda para no repetirlo.
    if [[ "${ODONTOCRM_REEXEC:-0}" != "1" && -f "$CODE_DIR/infra/fedora/odontocrm" ]]; then
      ok 'el comando se re-ejecuta con la versión recién instalada (los pasos que quedan ya son los nuevos)'
      exec env ODONTOCRM_REEXEC=1 ODONTOCRM_RAMA="$rama" "$0" actualizar
    fi
    npm ci --silent || morir 'falló npm ci'
    # El registro se guarda: un error de TypeScript en el servidor dejaba al operador sin
    # la causa y tenía que reproducir la compilación a mano.
    npm run build >/tmp/odontocrm-build.log 2>&1 ||
      { tail -30 /tmp/odontocrm-build.log; morir 'falló la compilación (registro: /tmp/odontocrm-build.log)'; }
    ok 'compilado'
    for s in "${SERVICIOS[@]}"; do
      # El entorno se carga con `tools/con-entorno.mjs`, NO con `source`: los .env no son
      # archivos de shell y bash rompía valores legítimos en silencio (un WEB_ORIGIN con
      # coma y espacio quedaba vacío; una contraseña con `$` se expandía).
      (cd "$CODE_DIR" && NODE_ENV=production node tools/con-entorno.mjs "$ETC_DIR" "$s" -- \
        node "services/$s/dist/db/migrate.js") >"/tmp/odontocrm-migrar-$s.log" 2>&1 ||
        { tail -5 "/tmp/odontocrm-migrar-$s.log"; morir "fallaron las migraciones de $s"; }
    done
    ok 'migraciones aplicadas'
    # PostgreSQL NO se reinicia: las migraciones no lo necesitan y reiniciarlo cortaba las
    # conexiones de los servicios que aún no se habían reiniciado (ventana de errores).
    # Y no se llama a `odontocrm.target`, que no existe en el repositorio: era código muerto
    # que aparentaba una intención.
    # La configuración del proxy también es una COPIA (la instala nginx/instalar.sh, no
    # install.sh). Si cambia en el repositorio —por ejemplo al añadir los enlaces del
    # certificado en varios formatos— sin este paso la actualización deja el proxy viejo y
    # esos enlaces responden 301 (caen en el redirect a HTTPS).
    if [[ -f /etc/nginx/conf.d/odontocrm.conf ]]; then
      host_actual="$(grep -m1 -oP 'server_name \K[^;]+' /etc/nginx/conf.d/odontocrm.conf 2>/dev/null | tr -s ' ' | sed 's/ *$//' || true)"
      if [[ -n "$host_actual" ]] &&
        bash "$CODE_DIR/infra/fedora/nginx/instalar.sh" --host="$host_actual" >/tmp/odontocrm-nginx.log 2>&1; then
        ok 'configuración del proxy al día (nginx/instalar.sh)'
      else
        av 'no pude actualizar la configuración del proxy; revisa /tmp/odontocrm-nginx.log'
      fi
    fi

    # El nombre por mDNS: si el servidor cambió de nombre y avahi sigue anunciando el viejo
    # (pasa porque `systemctl restart` no siempre reemplaza el proceso), los equipos no
    # resuelven `odontocrm.local`. Se corrige aquí, que es donde uno lo espera.
    if command -v avahi-resolve >/dev/null 2>&1; then
      anunciado="$(pgrep -a avahi-daemon 2>/dev/null | grep -oP 'running \[\K[^]]+' | head -1 || true)"
      if [[ -n "$anunciado" && "$anunciado" != "$(hostname).local" ]]; then
        systemctl stop avahi-daemon.socket avahi-daemon.service >/dev/null 2>&1 || true
        systemctl start avahi-daemon.socket avahi-daemon.service >/dev/null 2>&1 || true
        for _ in $(seq 1 10); do
          anunciado="$(pgrep -a avahi-daemon 2>/dev/null | grep -oP 'running \[\K[^]]+' | head -1 || true)"
          [[ "$anunciado" == "$(hostname).local" ]] && break
          sleep 1
        done
        if [[ "$anunciado" == "$(hostname).local" ]]; then
          ok "mDNS: avahi anuncia $anunciado (antes anunciaba otro nombre)"
        else
          av "avahi sigue anunciando «$anunciado»: reinícialo a mano (systemctl restart avahi-daemon)"
        fi
      fi
    fi

    reiniciados=0
    for s in "${SERVICIOS[@]}"; do
      systemctl restart "odontocrm@$s.service" >/dev/null 2>&1 && reiniciados=$((reiniciados + 1))
    done
    systemctl restart odontocrm-gateway.service >/dev/null 2>&1 ||
      av 'no pude reiniciar el gateway'
    ok "$reiniciados de ${#SERVICIOS[@]} servicios reiniciados"
    exec "$0" verificar
    ;;

  certificado|cert)
    necesita_root
    CA_DIR="${CAROOT:-/root/.local/share/mkcert}"
    CA_FIJA="$ETC_DIR/keys/odontocrm-ca.crt"
    destino=""
    for arg in "$@"; do
      case "$arg" in
        --exportar=*) destino="${arg#*=}" ;;
        --exportar) shift; destino="${1:-}" ;;
      esac
    done

    IP_CA="$(ip -4 route get 1.1.1.1 2>/dev/null | grep -oP 'src \K[0-9.]+' | head -1 || true)"
    [[ -n "$IP_CA" ]] || IP_CA="$(hostname -I 2>/dev/null | awk '{print $1}')"
    NOMBRE_CA="$(grep -m1 -oP 'server_name \K[^;]+' /etc/nginx/conf.d/odontocrm.conf 2>/dev/null | awk '{print $1}' || true)"
    [[ -n "$NOMBRE_CA" ]] || NOMBRE_CA="odontocrm.local"

    printf '%sCertificado interno (TLS)%s\n' "$C_TI" "$C_RE"
    if [[ -f /etc/pki/tls/certs/odontocrm.crt ]]; then
      ok "servidor: /etc/pki/tls/certs/odontocrm.crt"
      openssl x509 -in /etc/pki/tls/certs/odontocrm.crt -noout \
        -subject -dates -ext subjectAltName 2>/dev/null | sed 's/^/    /'
    else
      err 'no está el certificado del servidor: ejecuta la fase TLS (INSTALL.md §13.2)'
    fi

    # La CA que hay que instalar en los demás equipos.
    origen="$CA_FIJA"
    [[ -f "$origen" ]] || origen="$CA_DIR/rootCA.pem"
    if [[ -f "$origen" ]]; then
      ok "autoridad (CA) interna: $origen"
      openssl x509 -in "$origen" -noout -subject -dates 2>/dev/null | sed 's/^/    /'

      # Se deja una copia estable, que entra en el respaldo de configuración.
      install -d -m 0755 "$ETC_DIR/keys"
      install -m 0644 -o root -g root "$origen" "$CA_FIJA" 2>/dev/null || true
      ok "copia estable en $CA_FIJA (entra en el respaldo: --include-config)"

      # Y la copia PÚBLICA, que es la que nginx puede servir: /etc/odontocrm es
      # accesible solo para root y odontocrm, y nginx corre como usuario `nginx`
      # (servirla desde ahí daba 403 en texto plano). La CA es un certificado
      # público: no hay nada que proteger en que sea legible.
      install -d -m 0755 /var/www/odontocrm/ca
      install -m 0644 -o root -g root "$origen" /var/www/odontocrm/ca/odontocrm-ca.crt
      if command -v semanage >/dev/null && [[ "$(getenforce 2>/dev/null)" == "Enforcing" ]]; then
        semanage fcontext -a -t httpd_sys_content_t '/var/www/odontocrm(/.*)?' 2>/dev/null ||
          semanage fcontext -m -t httpd_sys_content_t '/var/www/odontocrm(/.*)?' 2>/dev/null || true
        restorecon -R /var/www/odontocrm 2>/dev/null || true
      fi
      ok 'copia pública en /var/www/odontocrm/ca/odontocrm-ca.crt (legible por nginx)'

      # ¿El proxy la sirve de verdad? Si la configuración de nginx es anterior a que
      # existiera `/ca.crt`, la petición acaba en la SPA y el equipo ve la página de
      # «no encontrada» del propio sistema, que despista mucho. Pasó al probarlo desde
      # otro dispositivo: el código estaba, la config instalada no.
      if ! grep -q '/ca.crt' /etc/nginx/conf.d/odontocrm.conf 2>/dev/null; then
        av 'la configuración del proxy NO sirve /ca.crt todavía: los equipos verán «no encontrada»'
        av 'arréglalo con:  sudo bash '"$CODE_DIR"'/infra/fedora/nginx/instalar.sh'
      elif ! grep -q '/var/www/odontocrm' /etc/nginx/conf.d/odontocrm.conf 2>/dev/null; then
        av 'la configuración del proxy es anterior a la corrección: apunta a /etc/odontocrm,'
        av 'que nginx NO puede leer (daba 403). Arrégialo con:'
        av '  sudo bash '"$CODE_DIR"'/infra/fedora/nginx/instalar.sh'
      else
        # Cuatro formatos, uno por familia de aparatos. Se comprueba cada uno: si falta,
        # ese aparato se queda con el aviso de certificado sin saber por qué.
        faltan=0
        for archivo in ca.crt ca.der odontocrm.mobileconfig ca-windows.ps1 ca-linux.sh; do
          codigo="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "http://127.0.0.1/$archivo" || echo 000)"
          if [[ "$codigo" == "200" ]]; then
            ok "/$archivo se sirve (200)"
          else
            av "/$archivo responde $codigo (los equipos que lo necesiten no podrán instalarlo)"
            faltan=$((faltan + 1))
          fi
        done
        (( faltan == 0 )) || av 'arréglalo con:  sudo bash '"$CODE_DIR"'/infra/fedora/nginx/instalar.sh'

        # Los dos scripts tienen que salir con la dirección REAL, no con el marcador: los
        # equipos los ejecutan tal cual, y una dirección sin sustituir (o la IP del día de la
        # instalación) los dejaba esperando hasta el timeout.
        for script in ca-linux.sh ca-windows.ps1; do
          servido="$(curl -sS --max-time 5 "http://127.0.0.1/$script" 2>/dev/null | grep -m1 -oE 'http://[^/ ]+' || true)"
          if [[ -z "$servido" ]]; then
            av "/$script no dice a qué dirección conectarse (revisa el sub_filter del proxy)"
          elif [[ "$servido" == *SERVIDOR* ]]; then
            av "/$script sigue con el marcador sin sustituir: el proxy NO está aplicando sub_filter"
          else
            ok "/$script apunta a $servido (la dirección con la que se descargue)"
          fi
        done

        echo
        printf '%sEn cada aparato%s (el certificado se instala una vez):\n' "$C_TI" "$C_RE"
        printf '  %sAndroid%s   http://%s/ca.crt  → Ajustes → Seguridad → Cifrado y credenciales\n' "$C_TI" "$C_RE" "${IP_CA:-<IP>}"
        printf '            → Instalar un certificado → Certificado de CA → elegir el archivo\n'
        printf '  %siOS/iPadOS%s http://%s/odontocrm.mobileconfig  (abrir con SAFARI, no Chrome)\n' "$C_TI" "$C_RE" "${IP_CA:-<IP>}"
        printf '            → Ajustes → Perfil descargado → Instalar\n'
        printf '            → y el paso que se olvida: Ajustes → General → Información →\n'
        printf '              Ajustes de confianza de certificados → ACTIVAR el de OdontoCRM\n'
        printf '  %sWindows%s  http://%s/ca.der  (doble clic → Instalar certificado →\n' "$C_TI" "$C_RE" "${IP_CA:-<IP>}"
        printf '            Equipo local → Entidades de certificación raíz de confianza)\n'
        printf '            o en PowerShell como administrador:\n'
        printf '              irm http://%s/ca-windows.ps1 | iex\n' "${IP_CA:-<IP>}"
        printf '  %smacOS%s    http://%s/odontocrm.mobileconfig  → Ajustes → Perfil descargado\n' "$C_TI" "$C_RE" "${IP_CA:-<IP>}"
        printf '  %sLinux%s    curl -fsSL http://%s/ca-linux.sh | sudo bash\n' "$C_TI" "$C_RE" "${IP_CA:-<IP>}"
        printf '            (Firefox tiene su propio almacén: security.enterprise_roots.enabled)\n'
        echo
        printf '  Y para el %snombre%s en vez de la IP, ver: sudo odontocrm nombre\n' "$C_TI" "$C_RE"
      fi

      if [[ -z "$destino" ]]; then
        destino="/var/lib/odontocrm/ca-para-dispositivos"
      fi
      install -d -m 0755 "$destino"
      install -m 0644 "$origen" "$destino/odontocrm-ca.crt"     # Android/Linux (PEM)
      install -m 0644 "$origen" "$destino/odontocrm-ca.pem"     # Firefox/macOS
      openssl x509 -in "$origen" -outform DER -out "$destino/odontocrm-ca.der" 2>/dev/null &&
        chmod 0644 "$destino/odontocrm-ca.der"                   # Windows: doble clic
      for extra in odontocrm.mobileconfig ca-windows.ps1 ca-linux.sh; do
        [[ -f "/var/www/odontocrm/ca/$extra" ]] &&
          install -m 0644 "/var/www/odontocrm/ca/$extra" "$destino/$extra"
      done
      ok "archivos listos en $destino para copiar por USB: .crt, .pem, .der, .mobileconfig y los dos scripts"

      cat <<EOF

  ${C_TI}Cómo quitar el aviso en cada equipo${C_RE} (uno por uno, se hace una sola vez):

    ${C_TI}LA PÁGINA QUE HAY QUE ABRIR EN CADA EQUIPO${C_RE}

        http://${IP_CA:-<IP-del-servidor>}/ca.crt
        (aquí: http://${IP_CA}/ca.crt — escríbela tal cual en el navegador del equipo)

      La aplicación, después de instalarla:  https://${NOMBRE_CA:-odontocrm.local}  o  https://${IP_CA}

    ${C_TI}Tablet o móvil Android${C_RE}
      1. Abre https://$(hostname -I 2>/dev/null | awk '{print $1}')/ca.crt y acepta la descarga
         (el navegador avisará antes: es normal, todavía no confía en el certificado).
      2. Ajustes → Seguridad → Cifrado y credenciales → Instalar un certificado
         → Certificado de CA → elige el archivo descargado.
      3. Android pide «Instalar de todos modos» y avisa de que la red podría
         supervisarse: es tu propio servidor, adelante.

    ${C_TI}iPhone / iPad${C_RE}
      1. Abre https://$(hostname -I 2>/dev/null | awk '{print $1}')/ca.crt y acepta «Permitir».
      2. Ajustes → General → VPN y gestión de dispositivos → instala el perfil.
      3. Ajustes → General → Información → Ajustes de confianza de certificados
         → activa «odontocrm» (sin este paso el certificado se instala pero no se confía).

    ${C_TI}Windows${C_RE}
      1. Descarga odontocrm-ca.crt y ábrelo → «Instalar certificado» →
         Equipo local → «Colocar todos los certificados en el siguiente almacén» →
         Entidades de certificación raíz de confianza.

    ${C_TI}Mac${C_RE}
      1. Abre odontocrm-ca.pem → Llavero «Sistema» → doble clic → Confiar siempre.

    ${C_TI}Linux (Arch, Fedora, Ubuntu…)${C_RE}
      Arch:    sudo trust anchor --store odontocrm-ca.crt
               (o: sudo cp odontocrm-ca.crt /etc/ca-certificates/trust-source/anchors/ && sudo update-ca-trust)
      Fedora:  sudo cp odontocrm-ca.crt /etc/pki/ca-trust/source/anchors/ && sudo update-ca-trust
      Ubuntu:  sudo cp odontocrm-ca.crt /usr/local/share/ca-certificates/ && sudo update-ca-certificates
      Comprobar sin -k:  curl -sI https://${IP_CA:-<IP>}/ | head -1
      Firefox va aparte: about:config → security.enterprise_roots.enabled = true

    ${C_TI}Smart TV${C_RE}
      Muchas no permiten instalar una CA. Alternativa: entrar por HTTP solo para la
      pantalla (si el televisor lo permite) o conectarle un mini-PC/tablet.
      ${C_AV}Nunca${C_RE} desactives la validación del servidor para «que funcione»: quita
      la protección justo donde circulan los datos clínicos.

    ${C_TI}La guía completa, sistema por sistema${C_RE}
      docs/CERTIFICADO_EN_LOS_EQUIPOS.md  (Android, iPhone/iPad, Windows, macOS,
      Linux con Arch/Fedora/Ubuntu, Firefox y televisores)

    ${C_TI}Si prefieres no instalar nada${C_RE}
      Puedes aceptar el aviso en cada equipo («Avanzado» → «Continuar»): funciona
      igual, pero el candado queda tachado y cualquiera que entre en la misma red
      podría suplantar al servidor. Para la clínica, instala la CA.

EOF
    else
      err "no encuentro la CA de mkcert (busqué $CA_FIJA y $CA_DIR/rootCA.pem)"
      av 'se crea con: sudo mkcert -install   (INSTALL.md §13.2)'
    fi
    ;;

  nombre|mdns|dns)
    necesita_root
    ARREGLAR_NOMBRE=0
    for arg in "$@"; do
      case "$arg" in --arreglar|-a|--si) ARREGLAR_NOMBRE=1 ;; esac
    done
    NOMBRE_ESPERADO="odontocrm.local"
    [[ -f /etc/nginx/conf.d/odontocrm.conf ]] &&
      NOMBRE_ESPERADO="$(grep -m1 -oP 'server_name \K[^;]+' /etc/nginx/conf.d/odontocrm.conf 2>/dev/null |
        awk '{print $1}' || true)"
    [[ -n "$NOMBRE_ESPERADO" ]] || NOMBRE_ESPERADO=odontocrm.local
    IP_LAN="$(ip -4 route get 1.1.1.1 2>/dev/null | grep -oP 'src \K[0-9.]+' | head -1 || true)"

    echo "Cómo entran los demás equipos a «$NOMBRE_ESPERADO»"
    echo
    # ¿Qué anuncia avahi? La respuesta está en el propio proceso: `avahi-daemon: running [fedora.local]`.
    anunciado="$(pgrep -a avahi-daemon 2>/dev/null | grep -oP 'running \[\K[^]]+' | head -1 || true)"
    if [[ -z "$anunciado" ]]; then
      av 'avahi no está corriendo: sin él no hay nombre por mDNS'
      (( ARREGLAR_NOMBRE )) && { systemctl enable --now avahi-daemon >/dev/null 2>&1 || true; }
      echo '      sudo systemctl enable --now avahi-daemon'
    elif [[ "$anunciado" == "$NOMBRE_ESPERADO" ]]; then
      ok "avahi anuncia $anunciado"
    elif (( ARREGLAR_NOMBRE )); then
      # El demonio publica el nombre que tenía al arrancar, y `systemctl restart` no siempre
      # reemplaza el proceso (visto en la PC de pruebas: el servicio decía «Started» y seguía
      # anunciando `fedora.local`). Se para y se arranca, comprobando **lo que anuncia**.
      systemctl stop avahi-daemon.socket avahi-daemon.service >/dev/null 2>&1 || true
      systemctl start avahi-daemon.socket avahi-daemon.service >/dev/null 2>&1 || true
      for _ in $(seq 1 10); do
        anunciado="$(pgrep -a avahi-daemon 2>/dev/null | grep -oP 'running \[\K[^]]+' | head -1 || true)"
        [[ "$anunciado" == "$NOMBRE_ESPERADO" ]] && break
        sleep 1
      done
      if [[ "$anunciado" == "$NOMBRE_ESPERADO" ]]; then
        ok "avahi anuncia ahora $NOMBRE_ESPERADO"
      else
        av "avahi sigue anunciando «${anunciado:-nada}»; revisa: journalctl -u avahi-daemon"
      fi
    else
      av "avahi anuncia «$anunciado», no «$NOMBRE_ESPERADO»: el demonio no se reinició desde el cambio de nombre"
      echo '      sudo odontocrm nombre --arreglar'
    fi
    if [[ -n "$anunciado" ]] && timeout 3 avahi-resolve -n "$NOMBRE_ESPERADO" >/dev/null 2>&1; then
      ok "el nombre se resuelve por mDNS en esta red"
    elif [[ -n "$anunciado" && "$anunciado" == "$NOMBRE_ESPERADO" ]]; then
      av 'esta red no responde a la multidifusión (avahi publica el nombre, pero nadie contesta)'
    fi

    echo
    echo "  Los tres caminos, de mejor a peor:"
    echo "    1) DNS propio o del router  → funciona en TODOS los equipos, incluidos tablets Android"
    echo "    2) mDNS (odontocrm.local)   → sin configurar nada, pero Android no lo resuelve en el navegador"
    echo "    3) archivo hosts por equipo → solo Windows, macOS y Linux (Android necesita root)"
    echo "    4) la IP tal cual           → siempre funciona: el certificado ya la incluye"
    echo
    echo "  IP de este servidor ahora mismo: ${IP_LAN:-?}"
    echo "  Certificado de la CA para instalar en cada equipo:  http://${IP_LAN:-<IP>}/ca.crt"
    echo
    echo "  Con la IP (lo más simple si son pocos equipos):"
    echo "      https://${IP_LAN:-<IP>}"
    echo
    echo "  Si un equipo no resuelve el nombre y quieres el camino 1, en ESTE servidor:"
    echo "      sudo bash $CODE_DIR/infra/fedora/nombre/instalar-dns.sh"
    ;;

  credenciales|sincronizar-credenciales|sincronizar)
    necesita_root
    # **Ya no copia nada.** Antes este comando "sincronizaba" las credenciales de los
    # `.env` del repositorio hacia /etc/odontocrm, y ese traslado era justo la causa de
    # fondo de los fallos: dos copias del mismo secreto que se desfasan en silencio
    # (ADR 0043). Ahora hay UNA sola copia, la escriben 20-aprovisionar.sh y aquí solo
    # se COMPRUEBA, con una conexión real por servicio.
    #
    # Si algo no conecta, el arreglo es volver a aprovisionar (que converge la base a lo
    # que dicen los archivos), no copiar de un sitio a otro.
    INFORME="$CODE_DIR/infra/fedora/instalar/aprovisionar.mjs"
    [[ -f "$INFORME" ]] || INFORME="$PWD/infra/fedora/instalar/aprovisionar.mjs"
    [[ -f "$INFORME" ]] || morir 'no encuentro infra/fedora/instalar/aprovisionar.mjs en el código'

    if node "$INFORME" --env-dir="$ETC_DIR" --solo-verificar; then
      ok 'las 9 credenciales conectan: /etc/odontocrm y la base están de acuerdo'
    else
      av 'alguna credencial NO conecta (arriba se dice cuál y qué archivo mirar)'
      av "  se arregla volviendo a aprovisionar:  sudo bash $CODE_DIR/infra/fedora/instalar/20-aprovisionar.sh"
      exit 1
    fi
    ;;

  red|ip|lan)
    necesita_root
    # La IP con la que esta máquina sale a la red (la que hay que teclear desde un
    # equipo de la misma red). No es la de `hostname -I` a secas: esa puede incluir
    # interfaces virtuales (docker, virbr…).
    IP_LAN="$(ip -4 route get 1.1.1.1 2>/dev/null | grep -oP 'src \K[0-9.]+' | head -1 || true)"
    [[ -n "$IP_LAN" ]] || IP_LAN="$(hostname -I 2>/dev/null | awk '{print $1}')"
    RED_LAN="$(ip -o -f inet addr show dev "${IFACE_LAN:-$(ip -4 route get 1.1.1.1 2>/dev/null | grep -oP 'dev \K\S+' | head -1)}" 2>/dev/null | awk 'NR==1 {print $4; exit}' || true)"
    NOMBRE="$(grep -m1 -oP 'server_name \K[^;]+' /etc/nginx/conf.d/odontocrm.conf 2>/dev/null | awk '{print $1}' || true)"

    printf '%sDirecciones para entrar al sistema%s\n' "$C_TI" "$C_RE"
    printf '  %shttps://%s%s   (por el nombre; hace falta una línea en el hosts de cada equipo)\n' "$C_TI" "${NOMBRE:-odontocrm.local}" "$C_RE"
    printf '  %shttps://%s%s      (por la IP de esta máquina en la red actual)\n' "$C_TI" "$IP_LAN" "$C_RE"
    printf '  %sDel mismo servidor%s también sirve https://127.0.0.1\n' "$C_TI" "$C_RE"
    echo
    echo "  nginx escucha en:"
    ss -lntp 2>/dev/null | grep ':443' | awk '{print "    " $4}' | sort -u
    echo "  (0.0.0.0:443 = todas las interfaces; el firewall es quien decide quién entra)"
    echo

    problemas=0

    # 1) Firewall: hay DOS formas válidas de publicar el proxy:
    #      a) `https` como SERVICIO en la zona de la interfaz → sigue a la interfaz y
    #         vale en cualquier red (la que deja el despliegue por defecto);
    #      b) una regla por RANGO (`--lan-cidr`) → la estricta de la clínica.
    #    La comprobación tiene que entender las dos: antes solo miraba las reglas por
    #    rango y daba por malo un firewall que estaba perfecto.
    if systemctl is-active --quiet firewalld; then
      iface_fw="$(ip -4 route get 1.1.1.1 2>/dev/null | grep -oP 'dev \K\S+' | head -1 || true)"
      zona_fw="$(firewall-cmd --get-zone-of-interface="${iface_fw}" 2>/dev/null || echo public)"
      [[ -n "$zona_fw" && "$zona_fw" != "no" ]] || zona_fw=public
      servicios_zona="$(firewall-cmd --zone="$zona_fw" --list-services 2>/dev/null || true)"
      reglas="$(firewall-cmd --list-rich-rules 2>/dev/null | grep '443' | head -2 || true)"

      if printf '%s' "$servicios_zona" | grep -qw https; then
        ok "firewalld: 443 abierto en la zona «$zona_fw» (sigue a la interfaz: vale en cualquier red)"
        # El 80 es por donde se descarga la CA: si está cerrado, los equipos de la red no
        # pueden instalar el certificado (desde el propio servidor parece que va bien,
        # porque firewalld no filtra loopback).
        if printf '%s' "$servicios_zona" | grep -qw http; then
          ok 'el 80 está abierto (descarga de la CA y redirección a HTTPS)'
        else
          av 'el 80 está cerrado: los equipos no podrán descargar la CA por http://<servidor>/ca.crt'
          problemas=$((problemas + 1))
        fi
      elif [[ -n "$reglas" ]] && printf '%s' "$reglas" | grep -qF "$RED_LAN"; then
        ok "firewalld: 443 abierto para $RED_LAN (regla por rango)"
      elif [[ -n "$reglas" ]]; then
        av "firewalld tiene reglas de OTRA red (esta es $RED_LAN):"
        printf '%s\n' "$reglas" | sed 's/^/      /'
        problemas=$((problemas + 1))
      else
        av "firewalld no publica 443 (ni el servicio «https» en la zona $zona_fw ni una regla): nadie de la red podrá entrar"
        problemas=$((problemas + 1))
      fi
    else
      ok 'firewalld no está activo: nada bloquea el acceso'
    fi

    # 2) Certificado: ¿cubre la IP de ahora?
    if [[ -f /etc/pki/tls/certs/odontocrm.crt ]]; then
      if openssl x509 -in /etc/pki/tls/certs/odontocrm.crt -noout -ext subjectAltName 2>/dev/null | grep -qF "$IP_LAN"; then
        ok "el certificado incluye $IP_LAN"
      else
        av "el certificado NO incluye $IP_LAN (se emitió para la red anterior): el navegador avisará"
        problemas=$((problemas + 1))
      fi
    fi

    # 3) CORS: ¿WEB_ORIGIN admite esa dirección? Si no, el login falla sin decir por qué.
    origenes="$(sed -n 's/^WEB_ORIGIN=//p' /etc/odontocrm/odontocrm.env | head -1 || true)"
    if printf '%s' "$origenes" | grep -qF "$IP_LAN"; then
      ok 'WEB_ORIGIN admite la IP actual'
    else
      av "WEB_ORIGIN no incluye https://$IP_LAN (hoy: $origenes)"
      av "  es el CORS del gateway (importa si sirves la interfaz desde OTRO origen; con nginx, no)"
      problemas=$((problemas + 1))
    fi

    # 4) mDNS: ¿el nombre se resuelve solo (sin tocar el hosts de cada equipo)?
    #
    # Hay TRES causas distintas que se ven iguales desde fuera («el nombre no resuelve»):
    #   a) avahi sigue anunciando el nombre viejo porque no se reinició de verdad desde el
    #      cambio de nombre —pasó en la PC de pruebas: el servicio decía «reiniciado» y el
    #      proceso seguía con `fedora.local`—;
    #   b) la red no deja pasar la multidifusión (wifi de invitados, aislamiento de clientes);
    #   c) el equipo que consulta no sabe mDNS (los navegadores de Android, casi siempre).
    # Se distinguen mirando lo que anuncia el propio proceso, que es lo único fiable aquí.
    anunciado="$(pgrep -a avahi-daemon 2>/dev/null | grep -oP 'running \[\K[^]]+' | head -1 || true)"
    if ! command -v avahi-resolve >/dev/null || [[ -z "$anunciado" ]]; then
      av 'sin avahi en marcha: el nombre solo funcionaría con una línea en el hosts de cada equipo'
      av '  se activa con:  sudo systemctl enable --now avahi-daemon'
    elif [[ "$anunciado" != "${NOMBRE:-odontocrm.local}" ]]; then
      av "avahi anuncia «$anunciado» y no «${NOMBRE:-odontocrm.local}»: no se reinició desde el cambio de nombre"
      av '  se arregla con:  sudo systemctl restart avahi-daemon    (y repetir: sudo odontocrm red)'
    elif timeout 3 avahi-resolve -n "${NOMBRE:-odontocrm.local}" >/dev/null 2>&1; then
      ok "mDNS: avahi anuncia $anunciado y el nombre se resuelve en esta red"
    else
      av 'mDNS: avahi publica el nombre, pero esta red no responde a la multidifusión'
      av "  los equipos pueden entrar por https://$IP_LAN o con una línea en su hosts"
      av '  para que el nombre funcione en TODOS los equipos (incluidos tablets Android):'
      av "      sudo bash $CODE_DIR/infra/fedora/nombre/instalar-dns.sh"
    fi

    echo
    if (( problemas == 0 )); then
      ok 'todo apunta a la red actual: se puede entrar desde otro equipo'
      echo "    Recuerda instalar el certificado en cada equipo:  http://${IP_LAN}/ca.crt"
      exit 0
    fi

    av "$problemas cosa(s) apuntan a la red anterior:"

    # ── Arreglo automático: `odontocrm red --arreglar` ────────────────────────
    arreglar=0
    for arg in "$@"; do
      case "$arg" in --arreglar|-a|--si) arreglar=1 ;; esac
    done
    if (( ! arreglar )); then
      echo '    Se arreglan de una vez con:'
      printf '      sudo odontocrm red --arreglar\n'
      echo '      (adapta el firewall a la red actual, reemite el certificado con la IP de'
      echo '       ahora, actualiza WEB_ORIGIN y recarga el proxy: la CA no cambia, así que'
      echo '       los equipos que ya la tienen instalada siguen confiando)'
      exit 2
    fi

    printf '\n%sArreglando la red actual (%s)%s\n' "$C_TI" "$IP_LAN" "$C_RE"

    # a) Firewall: se abre 443 (y 80) en la ZONA de la interfaz de la red local, no
    #    para un rango fijo. Así sigue funcionando cuando cambia la red —el consultorio
    #    con IP reservada, o este PC de pruebas en otro wifi— sin tocar nada.
    if systemctl is-active --quiet firewalld; then
      iface="$(ip -4 route get 1.1.1.1 2>/dev/null | grep -oP 'dev \K\S+' | head -1 || true)"
      zona="$(firewall-cmd --get-zone-of-interface="${iface:-$(ip route | awk '/default/ {print $5; exit}')}" 2>/dev/null || echo public)"
      [[ -n "$zona" && "$zona" != "no" ]] || zona=public
      firewall-cmd --permanent --zone="$zona" --add-service=https >/dev/null 2>&1 || true
      firewall-cmd --permanent --zone="$zona" --add-service=http >/dev/null 2>&1 || true
      # Las reglas por rango que apuntan a OTRA red se retiran: se quedaron viejas y
      # confunden al siguiente que mire el firewall.
      firewall-cmd --list-rich-rules 2>/dev/null | grep 'port="443"' | while read -r regla; do
        printf '%s' "$regla" | grep -qF "$RED_LAN" || {
          firewall-cmd --permanent --remove-rich-rule="$regla" >/dev/null 2>&1 || true
          av "retirada una regla vieja del firewall: $regla"
        }
      done
      firewall-cmd --reload >/dev/null 2>&1 || true
      ok "firewalld: 443 y 80 abiertos en la zona «$zona» (sigue a la interfaz, no a un rango)"
    fi

    # a-bis) mDNS: si el nombre del servidor es el correcto pero avahi no lo publica, es
    #        que arrancó con el anterior. Reiniciarlo lo republica al instante.
    if command -v avahi-resolve >/dev/null; then
      if [[ "$(hostname)" == "${NOMBRE:-odontocrm.local}" || "$(hostname)" == "${NOMBRE%%.*}" ]]; then
        # `systemctl restart` no siempre reemplaza el proceso (se vio en la PC de pruebas: el
        # servicio decía «Started» y el demonio seguía anunciando el nombre viejo). Se para y
        # se arranca, y se comprueba **lo que anuncia el proceso**, que es lo que importa.
        systemctl stop avahi-daemon.socket avahi-daemon.service >/dev/null 2>&1 || true
        systemctl start avahi-daemon.socket avahi-daemon.service >/dev/null 2>&1 || true
        for _ in $(seq 1 10); do
          anunciado_ahora="$(pgrep -a avahi-daemon 2>/dev/null | grep -oP 'running \[\K[^]]+' | head -1 || true)"
          [[ "$anunciado_ahora" == "${NOMBRE:-odontocrm.local}" ]] && break
          sleep 1
        done
        if [[ "${anunciado_ahora:-}" == "${NOMBRE:-odontocrm.local}" ]]; then
          ok "mDNS: avahi anuncia ${NOMBRE:-odontocrm.local} (los equipos no necesitan tocar el hosts)"
          timeout 3 avahi-resolve -n "${NOMBRE:-odontocrm.local}" >/dev/null 2>&1 ||
            av '  (esta red no responde a la multidifusión: los equipos pueden entrar por la IP)'
        else
          av "avahi sigue anunciando «${anunciado_ahora:-nada}»; reinícialo a mano: sudo systemctl restart avahi-daemon"
        fi
      else
        av "el servidor se llama $(hostname): para publicar ${NOMBRE:-odontocrm.local} hace falta"
        av "  sudo bash $CODE_DIR/infra/fedora/instalar-base-fedora.sh --nombre-mdns=${NOMBRE%%.*}"
      fi
    fi

    # b) El proxy sirve el nombre actualizado (por si cambió).
    sed -i "s|^server_name .*|server_name ${NOMBRE:-odontocrm.local} ${IP_LAN};|" /etc/nginx/conf.d/odontocrm.conf 2>/dev/null || true
    nginx -t >/dev/null 2>&1 && systemctl reload nginx >/dev/null 2>&1 &&
      ok "nginx: server_name ${NOMBRE:-odontocrm.local} $IP_LAN" || av 'nginx no recargó: revisa la configuración'

    # c) Certificado nuevo con el nombre y la IP de ahora. MISMA CA: los equipos que ya
    #    tengan el certificado instalado no tienen que hacer nada.
    if command -v mkcert >/dev/null; then
      mkcert -key-file /etc/pki/tls/private/odontocrm.key \
             -cert-file /etc/pki/tls/certs/odontocrm.crt \
             "${NOMBRE:-odontocrm.local}" localhost 127.0.0.1 "$IP_LAN" >/dev/null 2>&1 &&
        ok "certificado reemitido para ${NOMBRE:-odontocrm.local}, localhost, 127.0.0.1 y $IP_LAN" ||
        av 'no pude reemitir el certificado con mkcert'
      chmod 0600 /etc/pki/tls/private/odontocrm.key
      systemctl reload nginx >/dev/null 2>&1 || true
    fi

    # d) CORS: el nombre y la IP de ahora.
    archivo="/etc/odontocrm/odontocrm.env"
    if grep -qE '^WEB_ORIGIN=' "$archivo"; then
      sed -i "s|^WEB_ORIGIN=.*|WEB_ORIGIN=https://${NOMBRE:-odontocrm.local}, https://${IP_LAN}|" "$archivo"
      ok "WEB_ORIGIN=https://${NOMBRE:-odontocrm.local}, https://${IP_LAN}"
      for u in odontocrm@identity odontocrm@clinical odontocrm-gateway; do
        systemctl restart "$u.service" >/dev/null 2>&1 || true
      done
      ok 'identity, clinical y el gateway reiniciados (leen el origen permitido)'
    fi

    echo
    ok 'red actualizada. Comprueba con:  sudo odontocrm red'
    exit 0
    ;;

  selinux)
    necesita_root
    command -v getenforce >/dev/null || morir 'este sistema no usa SELinux'
    estado="$(getenforce)"
    printf '%sSELinux: %s%s\n' "$C_TI" "$estado" "$C_RE"
    if [[ "$estado" != "Enforcing" ]]; then
      av 'SELinux no está en Enforcing: no puede estar bloqueando nada'
    fi

    # Etiquetas de las rutas del proyecto (para comparar con las denegaciones).
    if command -v semanage >/dev/null; then
      echo '  Etiquetas del proyecto:'
      semanage fcontext -l 2>/dev/null | grep -E '/opt/odontocrm|/var/www/odontocrm|/var/lib/odontocrm|/var/log/odontocrm|/etc/odontocrm' |
        sed 's/^/    /' || av 'sin etiquetas propias (se aplican con install.sh y nginx/instalar.sh)'
    fi

    command -v ausearch >/dev/null || morir 'falta ausearch (paquete audit)'
    registro="$(ausearch -m avc -ts today 2>/dev/null | grep 'denied' || true)"
    denegaciones="$(printf '%s' "$registro" | grep -c 'denied' || true)"

    # No todo lo que SELinux deniega es del proyecto: Fedora tiene servicios del
    # sistema que deniegan cosas sin importancia todos los días (`systemd-rfkill`
    # pidiendo `dac_override` es el caso típico). Mezclarlas con las nuestras hace que
    # un aviso inocente parezca una avería —pasó al cerrar la Fase 10—, así que se
    # separan: primero lo del proyecto, y lo demás se menciona sin dramatizar.
    nuestras="$(printf '%s' "$registro" |
      grep -E 'comm="(nginx|node|chrome|headless_shell|postgres)"|path="/opt/odontocrm|path="/var/www/odontocrm|path="/var/lib/odontocrm|path="/etc/odontocrm|path="/var/log/odontocrm' || true)"
    nuestras_n="$(printf '%s' "$nuestras" | grep -c 'denied' || true)"
    ajenas_n=$(( ${denegaciones:-0} - ${nuestras_n:-0} ))
    echo

    if [[ "${nuestras_n:-0}" == "0" ]]; then
      ok "sin denegaciones del proyecto (nginx, los 9 servicios, Chromium, PostgreSQL)"
      if [[ "${ajenas_n:-0}" != "0" ]]; then
        av "$ajenas_n denegación(es) de servicios del SISTEMA (no del proyecto):"
        printf '%s' "$registro" | grep -oE 'comm="[^"]+"' | sort | uniq -c |
          sed 's/^/      /' | head -5
        av 'son habituales en Fedora (systemd-rfkill y compañía) y no afectan a OdontoCRM'
      fi
      exit 0
    fi

    av "$nuestras_n denegación(es) DEL PROYECTO hoy. Últimas diez:"
    printf '%s' "$nuestras" | tail -10 | sed -E 's/.*(denied[^\n]*)/    \1/' | cut -c1-160

    echo
    echo "  ${C_TI}Causas típicas y su arreglo${C_RE}"
    echo "    · nginx no puede leer un archivo (avc: denied { read } ... path=/…):"
    echo "        sudo semanage fcontext -a -t httpd_sys_content_t '<ruta>(/.*)?' && sudo restorecon -R <ruta>"
    echo "    · nginx no puede conectarse al gateway (name_connect ... port=8090):"
    echo "        sudo setsebool -P httpd_can_network_connect on"
    echo "    · Chromium/Playwright (execmod, execmem) o un archivo en /tmp:"
    echo "        revisa que el servicio use /var/lib/odontocrm y no escriba en /opt"
    echo "    · Si son de ANTES de un arreglo, quita el ruido y vuelve a probar:"
    echo "        sudo ausearch -m avc -ts today --raw | audit2allow -a   (solo para LEER, no lo apliques a ciegas)"
    echo
    av 'nunca desactives SELinux para «que funcione»: se etiqueta la ruta, que es lo correcto'
    exit 2
    ;;

  con-entorno|env)
    necesita_root
    servicio="${1:-}"; shift || true
    [[ "${1:-}" == "--" ]] && shift
    [[ -n "$servicio" && -f "$ETC_DIR/$servicio.env" ]] ||
      morir "uso: odontocrm con-entorno <servicio> -- <comando>   (servicios: ${SERVICIOS[*]}, gateway)"
    [[ $# -gt 0 ]] || morir 'falta el comando que hay que ejecutar después de «--»'
    cd "$CODE_DIR" || morir "no existe $CODE_DIR"
    # Los secretos se leen de los archivos y se pasan por entorno, nunca como
    # argumentos (en `ps` los vería cualquiera de la máquina).
    export SERVICIO="$servicio" ETC_DIR="$ETC_DIR" NODE_ENV=production ODONTOCRM_ENV_DIR="$ETC_DIR"
    # Mismo criterio que en las migraciones: nada de `source`, que interpreta los valores
    # como shell. `con-entorno` los lee tal cual y ejecuta el comando con ese entorno.
    exec node "$CODE_DIR/tools/con-entorno.mjs" "$ETC_DIR" "$servicio" -- "$@"
    ;;

  parar|stop|detener)
    necesita_root
    todo=0
    for arg in "$@"; do
      case "$arg" in --todo|--con-base|--todo=*|--con-base=*) todo=1 ;; esac
    done

    # El gateway PRIMERO: es la puerta de entrada. Si se para al final, las peticiones
    # que estén en curso se quedan colgadas contra servicios que ya no están.
    systemctl stop odontocrm-gateway.service >/dev/null 2>&1 || true
    ok 'gateway detenido (la puerta)'
    parados=0
    for s in "${SERVICIOS[@]}"; do
      systemctl stop "odontocrm@$s.service" >/dev/null 2>&1 && parados=$((parados + 1))
    done
    ok "$parados servicio(s) detenido(s)"

    if (( todo )); then
      # PostgreSQL al final y a propósito: los servicios ya están parados, así que no
      # hay nadie a quien dejar a medias.
      systemctl stop nginx >/dev/null 2>&1 || true
      systemctl stop postgresql >/dev/null 2>&1 || true
      ok 'nginx y PostgreSQL detenidos (--todo): el sistema queda completamente parado'
    else
      av 'nginx y PostgreSQL siguen en marcha (el proxy dará 502 mientras tanto)'
      av 'para pararlo TODO (incluidos el proxy y la base):  sudo odontocrm parar --todo'
    fi
    ;;

  arrancar|start)
    necesita_root
    # Independiente del estado: arranca lo que esté parado y deja lo que ya corría.
    systemctl is-active --quiet postgresql || systemctl start postgresql
    ok 'PostgreSQL en marcha'
    systemctl is-active --quiet nginx || systemctl start nginx
    ok 'nginx en marcha'
    for s in "${SERVICIOS[@]}"; do
      systemctl start "odontocrm@$s.service" >/dev/null 2>&1 || av "no pude arrancar odontocrm@$s"
    done
    ok "${#SERVICIOS[@]} servicios arrancados"
    systemctl start odontocrm-gateway.service >/dev/null 2>&1 || av 'no pude arrancar el gateway'
    ok 'gateway arrancado; comprobando que los nueve escuchen…'
    exec "$0" verificar
    ;;

  reiniciar|restart|reinicio)
    necesita_root
    # Vale igual si el sistema estaba corriendo **o** si se paró antes con
    # `odontocrm parar` (o con `parar --todo`): se levanta lo que falte y se reinicia
    # el resto. Antes no arrancaba PostgreSQL ni nginx, así que tras un `parar --todo`
    # el sistema se quedaba a medias —y el error que se veía era de la verificación,
    # no del reinicio—.
    systemctl is-active --quiet postgresql || { systemctl start postgresql && ok 'PostgreSQL estaba parado: arrancado'; }
    systemctl is-active --quiet nginx || { systemctl start nginx && ok 'nginx estaba parado: arrancado'; }

    for s in "${SERVICIOS[@]}"; do
      # `restart` arranca lo que esté detenido: no hace falta saber en qué estado está.
      systemctl restart "odontocrm@$s.service" >/dev/null 2>&1 ||
        av "no pude reiniciar odontocrm@$s"
    done
    ok "${#SERVICIOS[@]} servicios reiniciados"
    # El gateway al FINAL: así no atiende peticiones mientras sus servicios reinician.
    systemctl restart odontocrm-gateway.service >/dev/null 2>&1 || av 'no pude reiniciar el gateway'
    ok 'gateway reiniciado; comprobando que los nueve escuchen…'
    exec "$0" verificar
    ;;

  compilar|build)
    necesita_root
    cd "$CODE_DIR" || morir "no existe $CODE_DIR"
    if [[ -f "$CODE_DIR/infra/fedora/odontocrm" ]] &&
       ! cmp -s "$CODE_DIR/infra/fedora/odontocrm" /usr/local/bin/odontocrm; then
      install -m 0755 -o root -g root "$CODE_DIR/infra/fedora/odontocrm" /usr/local/bin/odontocrm
      av 'el comando del servidor estaba viejo: se actualizó (vuelve a ejecutar si no ves los cambios)'
    fi
    ok "versión en el disco: $(git rev-parse --short HEAD 2>/dev/null || echo 'sin git')"
    npm ci --silent || morir 'falló npm ci'
    npm run build >/tmp/odontocrm-build.log 2>&1 ||
      { tail -30 /tmp/odontocrm-build.log; morir 'falló la compilación (registro: /tmp/odontocrm-build.log)'; }
    ok 'compilado (TypeScript → dist/ y la SPA en apps/web/dist)'
    av 'los servicios siguen con el código anterior hasta que se reinicien: usa «odontocrm arrancar» (o «reiniciar»)'
    ;;

  recompilar|rebuild)
    necesita_root
    cd "$CODE_DIR" || morir "no existe $CODE_DIR"
    printf '%sRecompilando %s%s\n' "$C_TI" "$CODE_DIR" "$C_RE"
    ok "versión en el disco: $(git rev-parse --short HEAD 2>/dev/null || echo 'sin git')"
    npm ci --silent || morir 'falló npm ci'
    npm run build >/tmp/odontocrm-build.log 2>&1 ||
      { tail -30 /tmp/odontocrm-build.log; morir 'falló la compilación (registro: /tmp/odontocrm-build.log)'; }
    ok 'compilado (TypeScript → dist/)'
    for s in "${SERVICIOS[@]}"; do
      systemctl restart "odontocrm@$s.service" >/dev/null 2>&1 || av "no pude reiniciar odontocrm@$s"
    done
    systemctl restart odontocrm-gateway.service >/dev/null 2>&1 || av 'no pude reiniciar el gateway'
    av 'no se aplicaron migraciones: si el cambio toca el esquema, usa «odontocrm actualizar»'
    exec "$0" verificar
    ;;

  modo-test)
    necesita_root
    accion="${1:-estado}"; archivo="$ETC_DIR/odontocrm.env"
    case "$accion" in
      on|off)
        valor=$([[ "$accion" == "on" ]] && echo true || echo false)
        sed -i "s|^TEST_MODE=.*|TEST_MODE=${valor}|; s|^ALLOW_TEST_MODE=.*|ALLOW_TEST_MODE=${valor}|" "$archivo"
        if [[ "$valor" == "true" && "${NODE_ENV:-production}" == "production" ]]; then
          av 'ojo: con NODE_ENV=production el modo test sigue bloqueado (ADR 0020)'
        fi
        ok "modo test $accion en $archivo (reinicia los servicios para que lo lean)"
        for s in "${SERVICIOS[@]}"; do systemctl restart "odontocrm@$s.service" >/dev/null 2>&1 || true; done
        systemctl restart odontocrm-gateway.service >/dev/null 2>&1 || true
        ;;
      estado)
        grep -E '^(TEST_MODE|ALLOW_TEST_MODE)=' "$archivo" 2>/dev/null | sed 's/^/  /' || av 'no encuentro el archivo común'
        curl -s --max-time 4 http://127.0.0.1:8090/api/v1/meta 2>/dev/null |
          python3 -c 'import json,sys; print("  el gateway dice:", json.load(sys.stdin).get("testMode"))' 2>/dev/null || true
        ;;
      *) morir 'uso: odontocrm modo-test <on|off|estado>' ;;
    esac
    ;;

  *) err "orden desconocida: $ORDEN"; echo; ayuda; exit 2 ;;
esac

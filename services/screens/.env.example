# OdontoCRM — plantilla de `services/screens/.env`
#
# **Convención:** las líneas SIN comentar son claves que **deben estar** en el `.env`
# (las escribe `npm run db:bootstrap`). Las comentadas son opcionales y su valor por
# defecto está en `services/screens/src/config.ts`.
#
#   npm run db:bootstrap        # reescribe las claves de la base
#   npm run env:check           # dice si falta alguna clave
#   pm2 restart odontocrm-screens

# ── Base de datos (la escribe `npm run db:bootstrap`) ───────────────────────
DATABASE_URL=postgres://odonto_screens:CAMBIAR@127.0.0.1:5432/odonto_screens
EVENTS_DATABASE_URL=postgres://odonto_events:CAMBIAR@127.0.0.1:5432/odonto_events
INTERNAL_SERVICE_SECRET=secreto-compartido-entre-servicios-minimo-16-caracteres

# ── Opcionales (valor por defecto entre paréntesis) ─────────────────────────
# SERVICE_VERSION=0.1.0
# NODE_ENV=development
# LOG_LEVEL=debug
# LOG_PRETTY=false
# TZ=America/Caracas
# SCREENS_HOST=127.0.0.1
# SCREENS_PORT=4007
# DATABASE_POOL_MAX=10
# SCREEN_CALLS_SHOWN=3             (llamados que caben en la pantalla de la sala)
# SCREEN_CALL_TTL_SECONDS=120      (cuánto dura un llamado en pantalla)
# SCREEN_KEEPALIVE_SECONDS=20      (latido de la pantalla al servicio)
# CHAIR_LABEL=Consultorio 1        (nombre del sillón en el displaylobby)
# CLINIC_NAME=Consultorio - Od. Erika Gómez
# PATIENTS_URL=http://127.0.0.1:4002
# CLINICAL_URL=http://127.0.0.1:4005

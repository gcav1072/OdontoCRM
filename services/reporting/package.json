{
  "name": "@odontocrm/reporting",
  "version": "0.1.0",
  "private": true,
  "description": "Reportes y KPIs: read model por eventos, vistas materializadas y exportación",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",

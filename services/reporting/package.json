  },
  "dependencies": {
    "@odontocrm/contracts": "*",
    "@odontocrm/db": "*",
    "@odontocrm/events": "*",
    "@odontocrm/kernel": "*",
    "fastify": "^5.12.5",
    "playwright": "^1.63.0"
  }
}

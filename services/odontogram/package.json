{
  "name": "@odontocrm/odontogram",
  "version": "0.1.0",
  "private": true,
  "description": "Odontograma FDI: captura por excepción, histórico de hallazgos y eventos",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/index.js",

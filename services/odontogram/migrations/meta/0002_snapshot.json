        "chk_tooth_findings_tooth_number": {
          "name": "chk_tooth_findings_tooth_number",
          "value": "(\"tooth_findings\".\"tooth_number\" between 11 and 48 or \"tooth_findings\".\"tooth_number\" between 51 and 85)"
        },
        "chk_tooth_findings_surface": {
          "name": "chk_tooth_findings_surface",
          "value": "\"tooth_findings\".\"surface\" is null or \"tooth_findings\".\"surface\" in ('vestibular', 'lingual', 'occlusal', 'mesial', 'distal')"
        },
        "chk_tooth_findings_condition": {
          "name": "chk_tooth_findings_condition",
          "value": "\"tooth_findings\".\"condition\" in ('caries', 'restauracion', 'ausente', 'extraccion_indicada', 'corona', 'implante', 'endodoncia')"
        },
        "chk_tooth_findings_state": {
          "name": "chk_tooth_findings_state",
          "value": "\"tooth_findings\".\"state\" in ('pendiente', 'completado')"
        },
        "chk_tooth_findings_state_allowed": {
          "name": "chk_tooth_findings_state_allowed",
          "value": "(\n        (\"tooth_findings\".\"condition\" in ('caries', 'extraccion_indicada') and \"tooth_findings\".\"state\" = 'pendiente')\n        or (\"tooth_findings\".\"condition\" = 'ausente' and \"tooth_findings\".\"state\" = 'completado')\n        or \"tooth_findings\".\"condition\" in ('restauracion', 'corona', 'implante', 'endodoncia')\n      )"
        },
        "chk_tooth_findings_scope": {
          "name": "chk_tooth_findings_scope",
          "value": "(\"tooth_findings\".\"surface\" is null and \"tooth_findings\".\"condition\" in ('ausente', 'extraccion_indicada', 'corona', 'implante', 'endodoncia')) or (\"tooth_findings\".\"surface\" is not null and \"tooth_findings\".\"condition\" in ('caries', 'restauracion'))"
        }
      },

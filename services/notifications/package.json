  },
  "dependencies": {
    "@hapi/boom": "9.1.4",
    "@odontocrm/contracts": "^1.1.0",
    "@odontocrm/db": "^1.1.0",
    "@odontocrm/events": "^1.1.0",
    "@odontocrm/kernel": "^1.1.0",
    "@odontocrm/storage": "^1.1.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6"
  }
}

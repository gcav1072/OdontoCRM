{
  "name": "@odontocrm/notifications",
  "version": "1.1.0",
  "private": true,
  "description": "Bot de Telegram y WhatsApp, plantillas, cola de envíos con reintentos y archivos .ics",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/index.js",

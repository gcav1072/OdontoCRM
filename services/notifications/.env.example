# OdontoCRM — plantilla de `services/notifications/.env`
#
# **Convención:** las líneas SIN comentar son claves que **deben estar** en el `.env`
# (las repone `npm run db:bootstrap`, salvo el token del bot). Las comentadas son
# opcionales y su valor por defecto está en `services/notifications/src/config.ts`.
#
# Cómo se usa:
#   npm run db:bootstrap                     # escribe el .env con las claves de la base
#   notepad services\notifications\.env      # añade el token y el usuario del bot
#   npm run env:check                        # dice si falta alguna clave
#   pm2 restart odontocrm-notifications      # o `npm run stack:fijo`
#
# Guía completa: docs/COMANDOS.md §4 y docs/SEGURIDAD_SECRETOS.md.
# **Este archivo no lleva secretos de verdad**: va al repositorio, y el `.env` real
# está ignorado por Git.

# ── Base de datos (las escribe `npm run db:bootstrap`) ──────────────────────
DATABASE_URL=postgres://odonto_notifications:CAMBIAR@127.0.0.1:5432/odonto_notifications
# Cola de eventos compartida (pg-boss): la MISMA para los nueve servicios.
EVENTS_DATABASE_URL=postgres://odonto_events:CAMBIAR@127.0.0.1:5432/odonto_events
INTERNAL_SERVICE_SECRET=secreto-compartido-entre-servicios-minimo-16-caracteres

# ── Bot de Telegram ─────────────────────────────────────────────────────────
# El token lo da BotFather: /mybots → tu bot → API Token.
# ⚠ SIN TOKEN EL SERVICIO ARRANCA EN **MODO SIMULADO**: todo funciona (cola,
#   plantillas, .ics) pero los mensajes NO salen a Telegram; en el registro aparece
#   «Sin TELEGRAM_BOT_TOKEN: el servicio arranca en modo simulado».
TELEGRAM_BOT_TOKEN=
# Usuario del bot SIN @. Arma los enlaces t.me/<usuario>?start=<código> y el QR de
# vinculación de la bandeja; sin él no se puede ofrecer el enlace.
TELEGRAM_BOT_USERNAME=

# ── Opcionales (valor por defecto entre paréntesis) ─────────────────────────
# SERVICE_VERSION=0.1.0
# NODE_ENV=development            (development | test | production)
# LOG_LEVEL=debug
# LOG_PRETTY=false
# TZ=America/Caracas
# NOTIFICATIONS_HOST=127.0.0.1
# NOTIFICATIONS_PORT=4004
# DATABASE_POOL_MAX=10
# TELEGRAM_MODE=auto              (auto | real | simulado; auto = real si hay token)
# TELEGRAM_POLL_TIMEOUT_SECONDS=25
# TELEGRAM_API_BASE=https://api.telegram.org
# QUEUE_INTERVAL_MS=5000
# QUEUE_BATCH_SIZE=20
# ANTI_FLOOD_MAX_MESSAGES=10
# ANTI_FLOOD_WINDOW_SECONDS=60
# NOTIFICATION_MAX_ATTEMPTS=4
# RETRY_DELAYS_SECONDS=60,300,900,3600
# CLINIC_NAME=Consultorio - Od. Erika Gómez
# CLINIC_ADDRESS=Av. Luis del Valle García, C.E. Nueva Esparta, Planta Baja, Local 1-2
# CLINIC_EMAIL=citas@odontocrm.local
# PATIENTS_URL=http://127.0.0.1:4002
# SCHEDULING_URL=http://127.0.0.1:4003

# ── WhatsApp Cloud API (Fase 4.1, opcional) ─────────────────────────────────
# Sin las cuatro primeras el adaptador de WhatsApp **no se activa** y el servicio
# sigue solo con Telegram; cuando estén, se enciende solo.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_BASE=https://graph.facebook.com/v21.0

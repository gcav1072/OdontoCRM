# ════════════════════════════════════════════════════════════════════════════
#  OdontoCRM — plantilla de variables de entorno
#  Copia este archivo como `.env` y completa los valores.
#  NUNCA subas el `.env` real al repositorio (ver docs/SEGURIDAD_SECRETOS.md).
# ════════════════════════════════════════════════════════════════════════════

# ─── Bootstrap de bases de datos (se usa una sola vez) ──────────────────────
# Contraseña del superusuario `postgres` definida al instalar PostgreSQL 18.
# Si la contraseña tiene @ : / ? # hay que codificarla en porcentaje.
PG_ADMIN_URL=postgres://postgres:CAMBIAR_ESTO@127.0.0.1:5432/postgres

# ─── Entorno general ────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
TZ=America/Caracas
# Modo test: carga datos ficticios y bloquea envíos reales (Fase 10).
TEST_MODE=false

# ─── Puertos internos (solo 127.0.0.1; la LAN entra por el gateway) ──────────
GATEWAY_PORT=8090
IDENTITY_PORT=4001
PATIENTS_PORT=4002
SCHEDULING_PORT=4003
NOTIFICATIONS_PORT=4004
CLINICAL_PORT=4005
ODONTOGRAM_PORT=4006
SCREENS_PORT=4007
REPORTING_PORT=4008

# ─── URLs internas usadas por el gateway y por las llamadas entre servicios ──
IDENTITY_URL=http://127.0.0.1:4001
PATIENTS_URL=http://127.0.0.1:4002
SCHEDULING_URL=http://127.0.0.1:4003
NOTIFICATIONS_URL=http://127.0.0.1:4004
CLINICAL_URL=http://127.0.0.1:4005
ODONTOGRAM_URL=http://127.0.0.1:4006
SCREENS_URL=http://127.0.0.1:4007
REPORTING_URL=http://127.0.0.1:4008
WEB_ORIGIN=http://127.0.0.1:5173

# ─── Cadenas de conexión por servicio ───────────────────────────────────────
# Las genera `npm run db:bootstrap` en los `.env` de cada servicio.
# Formato de referencia (no las escribas a mano):
# DATABASE_URL=postgres://odonto_identity:<aleatoria>@127.0.0.1:5432/odonto_identity

# ─── Secretos que se generan o se piden aparte ──────────────────────────────
# INTERNAL_SERVICE_SECRET=<lo genera db:bootstrap>
# COOKIE_SECRET=<lo genera db:bootstrap>
# JWT_PRIVATE_KEY_PATH=./services/identity/.keys/jwt-private.pem   (Fase 1)
# TELEGRAM_BOT_TOKEN=<lo crea BotFather; va en services/notifications/.env>
# TELEGRAM_BOT_USERNAME=<usuario del bot>

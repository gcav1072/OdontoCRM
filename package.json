{
  "name": "odontocrm",
  "version": "0.1.0",
  "private": true,
  "description": "CRM para consultorio odontológico — microservicios Node.js + TypeScript",
  "type": "module",
  "engines": {
    "node": ">=22.9.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/contracts",
    "packages/events",
    "packages/db",
    "packages/kernel",
    "packages/storage",
    "packages/testing",
    "packages/ui",
    "services/identity",
    "services/patients",
    "services/scheduling",
    "services/notifications",
    "services/screens",
    "services/clinical",
    "services/odontogram",
    "services/reporting",
    "apps/gateway",
    "apps/web"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w @odontocrm/web",
    "build:node": "tsc -b",
    "typecheck": "tsc -b && npm run typecheck -w @odontocrm/web",
    "dev": "concurrently -k -n tsc,identity,patients,scheduling,notif,screens,clinical,odonto,reporting,gateway,web -c blue,green,yellow,magenta,white,gray,cyan,blue,magenta,red,blue \"npm:dev:build\" \"npm:dev:identity\" \"npm:dev:patients\" \"npm:dev:scheduling\" \"npm:dev:notifications\" \"npm:dev:screens\" \"npm:dev:clinical\" \"npm:dev:odontogram\" \"npm:dev:reporting\" \"npm:dev:gateway\" \"npm:dev:web\"",
    "predev": "node tools/dev-check.mjs",
    "dev:check": "node tools/dev-check.mjs",
    "env:check": "node tools/env-check.mjs",
    "dev:stop": "node tools/dev-stop.mjs",
    "stack:status": "node tools/stack.mjs status",
    "stack:dev": "node tools/stack.mjs dev",
    "stack:fijo": "node tools/stack.mjs fijo",
    "stack:down": "node tools/stack.mjs down",
    "stack:guard": "node tools/stack.mjs guard",
    "estado": "node tools/estado.mjs",
    "check:web": "node tools/check-web.mjs",
    "audit": "node tools/audit-conexiones.mjs",
    "telegram:menu": "node tools/telegram-menu.mjs",
    "dev:build": "tsc -b --watch --preserveWatchOutput",
    "dev:identity": "node --watch --env-file-if-exists=.env --env-file-if-exists=services/identity/.env services/identity/dist/index.js",
    "dev:patients": "node --watch --env-file-if-exists=.env --env-file-if-exists=services/patients/.env services/patients/dist/index.js",
    "dev:scheduling": "node --watch --env-file-if-exists=.env --env-file-if-exists=services/scheduling/.env services/scheduling/dist/index.js",
    "dev:notifications": "node --watch --env-file-if-exists=.env --env-file-if-exists=services/notifications/.env services/notifications/dist/index.js",
    "dev:screens": "node --watch --env-file-if-exists=.env --env-file-if-exists=services/screens/.env services/screens/dist/index.js",
    "dev:clinical": "node --watch --env-file-if-exists=.env --env-file-if-exists=services/clinical/.env services/clinical/dist/index.js",
    "dev:odontogram": "node --watch --env-file-if-exists=.env --env-file-if-exists=services/odontogram/.env services/odontogram/dist/index.js",
    "dev:reporting": "node --watch --env-file-if-exists=.env --env-file-if-exists=services/reporting/.env services/reporting/dist/index.js",
    "dev:gateway": "node --watch --env-file-if-exists=.env --env-file-if-exists=apps/gateway/.env apps/gateway/dist/index.js",
    "dev:web": "npm run dev -w @odontocrm/web",
    "start:identity": "node --env-file-if-exists=.env --env-file-if-exists=services/identity/.env services/identity/dist/index.js",
    "start:patients": "node --env-file-if-exists=.env --env-file-if-exists=services/patients/.env services/patients/dist/index.js",
    "start:scheduling": "node --env-file-if-exists=.env --env-file-if-exists=services/scheduling/.env services/scheduling/dist/index.js",
    "start:notifications": "node --env-file-if-exists=.env --env-file-if-exists=services/notifications/.env services/notifications/dist/index.js",
    "start:screens": "node --env-file-if-exists=.env --env-file-if-exists=services/screens/.env services/screens/dist/index.js",
    "start:clinical": "node --env-file-if-exists=.env --env-file-if-exists=services/clinical/.env services/clinical/dist/index.js",
    "start:odontogram": "node --env-file-if-exists=.env --env-file-if-exists=services/odontogram/.env services/odontogram/dist/index.js",
    "start:reporting": "node --env-file-if-exists=.env --env-file-if-exists=services/reporting/.env services/reporting/dist/index.js",
    "start:gateway": "node --env-file-if-exists=.env --env-file-if-exists=apps/gateway/.env apps/gateway/dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node tools/test-integration.mjs",
    "smoke:auth": "node tools/smoke-auth.mjs",
    "smoke:patients": "node tools/smoke-patients.mjs",
    "smoke:agenda": "node tools/smoke-agenda.mjs",
    "smoke:notifications": "node tools/smoke-notifications.mjs",
    "smoke:screens": "node tools/smoke-screens.mjs",
    "smoke:odontogram": "node tools/smoke-odontogram.mjs",
    "smoke:clinical": "node tools/smoke-clinical-session.mjs",
    "smoke:prescription": "node tools/smoke-prescription.mjs",
    "smoke:reporting": "node tools/smoke-reporting.mjs",
    "reports:latencia": "node tools/reportes-latencia.mjs",
    "e2e:flujo": "node tools/e2e-flujo.mjs",
    "e2e:reportes": "node tools/e2e-reportes.mjs",
    "e2e:clinica": "node tools/e2e-clinica.mjs",
    "check-secrets": "node tools/check-secrets.mjs",
    "db:bootstrap": "node infra/db/bootstrap.mjs",
    "db:migrate": "node tools/migrate-all.mjs",
    "db:reset": "node tools/db-reset.mjs",
    "db:verify-migrations": "node --env-file-if-exists=.env tools/verify-migrations.mjs",
    "db:generate:identity": "drizzle-kit generate --config services/identity/drizzle.config.ts",
    "db:generate:patients": "drizzle-kit generate --config services/patients/drizzle.config.ts",
    "db:generate:scheduling": "drizzle-kit generate --config services/scheduling/drizzle.config.ts",
    "db:generate:notifications": "drizzle-kit generate --config services/notifications/drizzle.config.ts",
    "db:generate:screens": "drizzle-kit generate --config services/screens/drizzle.config.ts",
    "db:generate:clinical": "drizzle-kit generate --config services/clinical/drizzle.config.ts",
    "db:generate:odontogram": "drizzle-kit generate --config services/odontogram/drizzle.config.ts",
    "db:generate:reporting": "drizzle-kit generate --config services/reporting/drizzle.config.ts",
    "keys:generate": "node --env-file-if-exists=.env --env-file-if-exists=services/identity/.env services/identity/dist/keys.js",
    "seed:users": "node --env-file-if-exists=.env --env-file-if-exists=services/identity/.env services/identity/dist/seed.js",
    "seed:demo": "node --env-file-if-exists=.env --env-file-if-exists=services/patients/.env services/patients/dist/seed.js",
    "seed:agenda": "node --env-file-if-exists=.env --env-file-if-exists=services/scheduling/.env services/scheduling/dist/seed.js",
    "seed:test": "node tools/seed-test.mjs",
    "seed:reset": "node tools/seed-test.mjs --reset",
    "seed:verify": "node tools/seed-verify.mjs",
    "verify": "npm run check-secrets && npm run lint && npm run format:check && npm run typecheck && npm run build && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
